{
  "expo": {
    "name": "Smart OBD Diagnostic",
    "slug": "meriva",
    "scheme": "smart-obd-diagnostic",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.meriva.smartdiagnostic",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#07111f",
          "barStyle": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#07111f"
        }
      ],
      "./plugins/withBluetoothLegacyPermissionLimits"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#07111f",
      "resizeMode": "contain"
    }
  }
}
