{
  "expo": {
    "name": "MERIVA SMART DIAGNOSTIC",
    "slug": "meriva-smart-diagnostic",
    "scheme": "meriva-smart-diagnostic",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": ["android"],
    "android": {
      "package": "com.meriva.smartdiagnostic",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
