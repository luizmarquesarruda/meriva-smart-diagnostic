{
  "expo": {
    "name": "MERIVA SMART",
    "slug": "meriva-smart-diagnostic",
    "scheme": "meriva-smart-diagnostic",
    "version": "1.0.1",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": ["android"],
    "android": {
      "package": "com.meriva.smartdiagnostic",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "assetBundlePatterns": ["**/*"],
    "experiments": { "typedRoutes": true, "tsconfigPaths": true }
  }
}
