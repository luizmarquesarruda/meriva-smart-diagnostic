{
  "name": "meriva-smart-diagnostic",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "test": "node tests/merivaAutosave.test.js && node tests/regression.test.js && node tests/gps.test.js",
    "build:apk": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "doctor": "npx expo-doctor",
    "validate": "npm run typecheck && npm test"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-file-system": "~17.0.1",
    "expo-router": "~3.5.23",
    "expo-splash-screen": "~0.27.5",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-bluetooth-classic": "1.73.0-rc.17",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "expo-constants": "~16.0.2",
    "expo-location": "~17.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@types/react": "~18.2.0",
    "typescript": "~5.3.3"
  }
}
