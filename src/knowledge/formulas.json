{
  "version": 2,
  "standard": "SAE J1979 / ISO 15031-5",
  "description": "Banco local de fórmulas determinísticas para converter bytes OBD-II em unidades de engenharia. Não usa eval.",
  "provenance": [
    {
      "source": "SAE J1979 / ISO 15031-5",
      "role": "referência técnica das fórmulas"
    },
    {
      "source": "OBD-II implementations reviewed on GitHub",
      "role": "comparação cruzada de implementações abertas"
    }
  ],
  "formulas": {
    "U8": {
      "operation": "u8"
    },
    "U16": {
      "operation": "u16"
    },
    "RPM": {
      "operation": "u16_div",
      "divisor": 4
    },
    "TEMP_C": {
      "operation": "u8_offset",
      "offset": -40
    },
    "PERCENT_255": {
      "operation": "u8_scale",
      "scale": 100,
      "divisor": 255
    },
    "FUEL_TRIM": {
      "operation": "u8_offset_scale",
      "offset": -128,
      "scale": 100,
      "divisor": 128
    },
    "MAF_GS": {
      "operation": "u16_div",
      "divisor": 100
    },
    "TIMING_DEG": {
      "operation": "u8_scale_offset",
      "scale": 0.5,
      "offset": -64
    },
    "VOLTS_1000": {
      "operation": "u16_div",
      "divisor": 1000
    },
    "O2_VOLTS": {
      "operation": "u8_div",
      "divisor": 200,
      "notes": "PID 0114: tensão no byte A; o byte B é informação adicional de ajuste STFT do sensor e não entra no valor de tensão."
    },
    "DISTANCE_KM": {
      "operation": "u16"
    },
    "FUEL_RATE_LH": {
      "operation": "u16_div",
      "divisor": 20
    },
    "ETHANOL_PERCENT": {
      "operation": "u8_scale",
      "scale": 100,
      "divisor": 255
    },
    "U8_X3": {
      "operation": "u8_scale",
      "scale": 3,
      "divisor": 1
    },
    "U16_SCALE_255": {
      "operation": "u16_scale_div",
      "scale": 100,
      "divisor": 255
    },
    "U16_X10": {
      "operation": "u16_scale",
      "scale": 10
    },
    "INJECTION_TIMING": {
      "operation": "u16_offset_scale",
      "offset": -26880,
      "scale": 0.0078125
    },
    "TORQUE_PERCENT": {
      "operation": "u8_offset",
      "offset": -125
    },
    "U16_DIV_32768": {
      "operation": "u16_div",
      "divisor": 32768
    },
    "U32": {
      "operation": "u32"
    }
  }
}
